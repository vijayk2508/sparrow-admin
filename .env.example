# ============================================================
# SPARROW ADMIN — environment template
# Copy to `.env` (local dev) and mirror every key in Vercel.
# Same Supabase + Firebase project as the public site
# (../sparrow-training-club). See VERCEL_ENV_SETUP.md.
# ============================================================

# ---- Supabase (same project as the public site) --------------
# supabase.com → project → Project Settings → API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# SERVER ONLY — never prefix with VITE_ (used by api/* serverless fns)
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Firebase web config (Google Sign-In / ID tokens) --------
# Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="sparrow-fitness-club.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sparrow-fitness-club"
VITE_FIREBASE_STORAGE_BUCKET="sparrow-fitness-club.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="884895679197"
VITE_FIREBASE_APP_ID="1:884895679197:web:c287ae561fa46572075134"
VITE_FIREBASE_MEASUREMENT_ID="G-Q6CWWH0911"

# ---- Firebase Admin (SERVER ONLY — used to verify ID tokens) --
# Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID="sparrow-fitness-club"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ---- App / API wiring ----------------------------------------
# Empty = same origin (production) or the Vite dev proxy (localhost:3002).
# Set to an absolute URL only if the API lives on another host.
VITE_API_BASE_URL=""

# Extra admin emails (comma-separated). Merged with DEFAULT_ADMIN_EMAILS
# in src/lib/firebase.ts. Server-side truth is the Supabase `admins` table.
VITE_ADMIN_EMAILS=""

# URL where this app is hosted (optional, informational)
APP_URL=""

