VITE_FIREBASE_APP_ID=""

# API base URL (backend). Empty = same origin / Vite proxy.
# Production: https://sparrow.com (or your public site domain)
VITE_API_BASE_URL=""

# Admin Panel — comma-separated list of extra admin emails.
VITE_ADMIN_EMAILS=""


# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

