{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    { "src": "^/api/health$", "dest": "/api/health.ts" },
    { "src": "^/api/auth/sync$", "dest": "/api/auth-sync.ts" },
    { "src": "^/api/me$", "dest": "/api/me.ts" },
    { "src": "^/api/upload$", "dest": "/api/upload.ts" },
        { "src": "^/api/admin/db$", "dest": "/api/admin-db.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}